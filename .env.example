# Copy to `.env` and fill in. `.env` is gitignored; never commit real values.
#
# These variables are only read by the opt-in live API tests. The SDK itself
# takes its configuration through the `NovaraFlexClient` constructor, and
# `pnpm test` runs fully offline when they are unset.

# Novara Flex API token used for the live validation tests. Prefer a dedicated
# test credential. The token must never appear in fixtures, logs, or test output.
NOVARA_FLEX_TOKEN=

# Optional. Overrides the API base URL for the live tests.
# Defaults to https://api.novaraflex.com/v1 when unset.
# NOVARA_FLEX_BASE_URL=
